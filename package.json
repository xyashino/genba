{
  "name": "genba",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@eslint/js": "9.39.5",
      "@types/bun": "1.4.4",
      "@types/node": "26.6.4",
      "@vitest/coverage-v8": "5.1.0",
      "drizzle-orm": "0.45.4",
      "eslint": "9.39.5",
      "eslint-config-prettier": "10.1.8",
      "eslint-plugin-only-warn": "1.2.1",
      "eslint-plugin-react": "7.37.5",
      "eslint-plugin-react-hooks": "7.1.1",
      "eslint-plugin-turbo": "2.11.10",
      "globals": "17.14.0",
      "handlebars": "4.7.10",
      "hono": "4.13.14",
      "husky": "9.1.7",
      "lint-staged": "17.6.0",
      "prettier": "3.9.10",
      "turbo": "2.11.10",
      "typescript": "6.0.3",
      "typescript-eslint": "8.72.2",
      "vitest": "5.1.0",
      "yaml": "2.9.1",
      "zod": "4.6.7"
    }
  },
  "trustedDependencies": [
    "esbuild"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write \"**/*.{ts,tsx,json,yaml,css,js,jsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,yaml,css,js,jsx}\"",
    "ci:format": "lint-staged",
    "ci:verify": "turbo run //#format:check lint check-types test build --ui=stream",
    "nitpick": "bun packages/nitpick/dist/cli.js",
    "nitpick:check": "bun packages/nitpick/dist/cli.js --check",
    "nitpick:sync": "bun packages/nitpick/dist/cli.js --sync",
    "prepare": "bun scripts/prepare.mjs"
  },
  "devDependencies": {
    "@repo/nitpick": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24.0.0"
  }
}
